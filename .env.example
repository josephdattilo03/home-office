# Copy to .env and fill in real values:  cp .env.example .env
# Write KEY=value with no spaces around "=".

# Mattermost
# Must match the address you open in the browser.
# Dev: http://localhost:8065   Server: https://chat.home.hoa (or your Tailscale name)
SITE_URL=http://localhost:8065
TZ=UTC

# Postgres
# Only applied the first time the postgres-data volume is created.
# Changing these later needs `docker compose down -v` (deletes all data).
POSTGRES_USER=mmuser
# URL-safe only (no @ / : #). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mattermost
